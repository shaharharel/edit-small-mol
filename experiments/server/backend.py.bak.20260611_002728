def _resolve_pose(row_id: int):
    """Return (cif_text, metadata) for the given row_id, or (None, None)."""
    key = str(row_id)
    if key in TOP1000_MANIFEST:
        m = TOP1000_MANIFEST[key]
        cif = TOP1000_ROOT / m["yaml_name"] / f"{m['yaml_name']}_model_0.cif"
        if cif.exists():
            meta = dict(m)
            meta["pose_name"] = m["yaml_name"]
            meta["pose_source"] = "top1000_boltz"
            return cif.read_text(), meta
    if key in POSES_MANIFEST:
        m = POSES_MANIFEST[key]
        cif = MEDCHEM10_ROOT / "predictions" / m["pose_name"] / f"{m['pose_name']}_model_0.cif"
        if cif.exists():
            meta = dict(m)
            meta["pose_source"] = "medchem10_boltz"
            return cif.read_text(), meta
    # 3,597 cohort cofolds sharded across from_{a..h}/<row_id>/
    for sub in COHORT_3597_ROOT.glob(f"from_*/{row_id}/{row_id}_model_0.cif"):
        if sub.exists():
            shard = sub.parent.parent.name
            return sub.read_text(), {"pose_source": "cohort_3597", "shard": shard,
                                     "pose_name": f"{row_id}", "row_id": row_id}
    # 2026-06-10 PM: F4 Boltz pool — keyed by SMILES (the F4 cohort uses different
    # row_ids than the live DF). Look up DF's SMILES for this row_id, then resolve
    # via the prebuilt F4_SMILES_TO_CIF map.
    try:
        df_row = DF.loc[DF["row_id"] == row_id]
        if len(df_row):
            smi = df_row.iloc[0].get("smiles")
            if smi and smi in F4_SMILES_TO_CIF:
                cif_path = F4_SMILES_TO_CIF[smi]
                if Path(cif_path).exists() and Path(cif_path).stat().st_size > 100:
                    return Path(cif_path).read_text(), {
                        "pose_source": "f4_boltz_pool",
                        "pose_name": Path(cif_path).parent.name,
                        "row_id": row_id,
                    }
    except Exception:
        pass
    return None, None


