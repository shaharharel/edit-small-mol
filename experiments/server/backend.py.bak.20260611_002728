# ── Brenk structural alerts (count) ─────────────────────────────────────────
# Brenk et al. ChemMedChem 2008 — reactive/toxic substructure filter,
# complementary to PAINS (which targets pan-assay interference). Catches
# acyl ureas, anhydrides, Michael acceptors outside the intended warhead,
# disulfides, etc. RDKit FilterCatalog with BRENK catalog (~110 SMARTS).
# Cached to data/paper_evaluation/brenk_alerts.csv (row_id, Brenk_alerts).
# First-time cost ~2 min on 520K rows; subsequent loads are instant.
BRENK_CACHE = PROJECT_ROOT / "data" / "paper_evaluation" / "brenk_alerts.csv"
_brenk_loaded_from_cache = False
if BRENK_CACHE.exists() and "smiles" in DF.columns:
    try:
        _bk = pd.read_csv(BRENK_CACHE)
        # Prefer SMILES-keyed merge (stable across row_id reshuffles caused by
        # adding new cohorts). Fall back to row_id-keyed merge if the cache
        # only carries row_id (legacy schema).
        if "smiles" in _bk.columns:
            _bk_uniq = _bk.drop_duplicates(subset=["smiles"], keep="first")
            DF = DF.merge(_bk_uniq[["smiles", "Brenk_alerts"]], on="smiles", how="left")
            n_bk = DF["Brenk_alerts"].notna().sum()
            print(f"[brenk] loaded cache (SMILES-keyed): {n_bk} of {len(DF)} rows from {BRENK_CACHE.name}")
            # Partial cover is fine — compute the missing rows below.
            _brenk_loaded_from_cache = n_bk == len(DF)
        elif "row_id" in DF.columns and set(DF["row_id"]).issubset(set(_bk["row_id"])):
            DF = DF.merge(
                _bk[["row_id", "Brenk_alerts"]].drop_duplicates(subset=["row_id"]),
                on="row_id", how="left",
            )
            n_bk = DF["Brenk_alerts"].notna().sum()
            print(f"[brenk] loaded cache (row_id-keyed): {n_bk} of {len(DF)} rows from {BRENK_CACHE.name}")
            _brenk_loaded_from_cache = True
        else:
            print(f"[brenk] cache stale (missing rows); will recompute")
    except Exception as _e:
        print(f"[brenk] cache load failed ({_e}); will recompute")

if not _brenk_loaded_from_cache and "smiles" in DF.columns and not os.environ.get("SKIP_BRENK_RECOMPUTE"):
    import time as _time
    from rdkit.Chem import FilterCatalog as _FilterCatalog
    _bparams = _FilterCatalog.FilterCatalogParams()
    _bparams.AddCatalog(_FilterCatalog.FilterCatalogParams.FilterCatalogs.BRENK)
    _brenk_cat = _FilterCatalog.FilterCatalog(_bparams)

    def _count_brenk(smi):
        if not isinstance(smi, str):
            return None
        m = Chem.MolFromSmiles(smi)
        if m is None:
            return None
        return int(len(_brenk_cat.GetMatches(m)))

    _t0 = _time.time()
    # Only compute for SMILES that weren't covered by the cache. Re-uses
    # cached values for the 1M+ rows that ARE covered, so adding a new cohort
    # only computes Brenk for its new SMILES (not the whole DF).
    if "Brenk_alerts" not in DF.columns:
        DF["Brenk_alerts"] = pd.NA
    missing_mask = DF["Brenk_alerts"].isna()
    n_missing = int(missing_mask.sum())
    if n_missing == 0:
        print(f"[brenk] cache fully covers DF; no recompute needed")
    else:
        # De-dup by SMILES so identical SMILES aren't re-evaluated.
        missing_smis = DF.loc[missing_mask, "smiles"].dropna().drop_duplicates()
        print(f"[brenk] recomputing for {len(missing_smis):,} unique missing SMILES "
              f"(of {n_missing:,} missing rows in {len(DF):,} total)")
        per_smi = missing_smis.apply(_count_brenk)
        smi_to_brenk = dict(zip(missing_smis.values, per_smi.values))
        DF.loc[missing_mask, "Brenk_alerts"] = DF.loc[missing_mask, "smiles"].map(smi_to_brenk)
        _dt = _time.time() - _t0
        n_bk = DF["Brenk_alerts"].notna().sum()
        print(f"[brenk] populated {n_bk:,} of {len(DF):,} rows in {_dt:.1f}s")
        # Write SMILES-keyed cache for next startup (stable across row_id changes).
        try:
            BRENK_CACHE.parent.mkdir(parents=True, exist_ok=True)
            out = DF[["smiles", "Brenk_alerts"]].dropna(subset=["smiles"]) \
                .drop_duplicates(subset=["smiles"])
            out.to_csv(BRENK_CACHE, index=False)
            print(f"[brenk] cached {len(out):,} SMILES → {BRENK_CACHE.name}")
        except Exception as _e:
            print(f"[brenk] cache write skipped ({_e})")

