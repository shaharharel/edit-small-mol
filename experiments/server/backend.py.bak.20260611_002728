def _precompute_default_filter():
    """Warm the default-filter cache so the very first /api/filter call from a
    fresh browser is instant. Runs at startup AFTER all DF setup.

    Skip behavior (2026-06-09): under low-memory hosts the cascade clone +
    composite scoring on a 1.17M-row DF can hit OOM-kill (3.4GB peak on a
    3.8GB VM). Set ``SKIP_PRECOMPUTE_FILTER=1`` to bypass; first request
    will be slow (~48s) but every subsequent press hits the TTL cache (5ms).
    Auto-skipped when ``len(DF) * mem-per-row estimate`` exceeds available
    RAM by a safety factor.
    """
    import os, time
    if str(os.environ.get("SKIP_PRECOMPUTE_FILTER", "0")).lower() in ("1", "true", "yes"):
        print("[precompute] skipped (SKIP_PRECOMPUTE_FILTER=1); first request will be slow but TTL cache covers retries", flush=True)
        return
    # Auto-skip on low-memory hosts. The pipeline materializes ~2x DF +
    # composite scoring intermediates. We estimate 8 bytes/cell as a rough
    # lower bound (mixed dtype) and need ~2x that as headroom.
    try:
        n_rows = len(DF)
        n_cols = len(DF.columns)
        # Conservative: 16 bytes per cell × 2.5 working multiplier.
        est_bytes = n_rows * n_cols * 16 * 2.5
        # Available RAM (Linux: /proc/meminfo MemAvailable).
        avail_bytes = None
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemAvailable:"):
                        avail_bytes = int(line.split()[1]) * 1024
                        break
        except FileNotFoundError:
            pass  # macOS / non-Linux — skip the auto-skip check.
        if avail_bytes is not None and est_bytes > avail_bytes:
            print(f"[precompute] skipped: est need {est_bytes/1e9:.1f}GB > "
                  f"avail {avail_bytes/1e9:.1f}GB. Set SKIP_PRECOMPUTE_FILTER=0 + "
                  f"resize VM to force on.", flush=True)
            return
    except Exception as e:
        print(f"[precompute] memory probe failed ({e}); attempting anyway", flush=True)
    t0 = time.time()
    try:
        result = _run_filter_pipeline(_default_filter_payload())
        _DEFAULT_FILTER_CACHE.update(result)
        print(f"[precompute] default filter cache warmed in {time.time()-t0:.2f}s "
              f"(library={result['counts'].get('total_unfiltered'):,}, "
              f"after_F0={result['counts'].get('after_filter0'):,}, "
              f"visible={result['n_visible']:,})", flush=True)
    except Exception as e:
        print(f"[precompute] default filter warmup failed: {e}", flush=True)


_precompute_default_filter()


