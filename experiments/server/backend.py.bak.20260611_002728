# ── DesirabilityScore (Team #1 ranking formula, 2026-06-10 PM) ──────────────
# Geometric mean of 5 percentile components:
#   DesirabilityScore = (P_potency)^0.35 × (P_pose)^0.25 × (P_shape)^0.20
#                     × (P_covgeom)^0.10 × (P_clean_reactivity)^0.10
#
# Each P_x is the cohort percentile rank in [0, 1] (higher = better) computed
# WITHIN the Boltz-having subset (the only mols where these cols are populated).
# Mols without Boltz get desirability_score = NaN.
#
# Why geometric mean: any single near-zero component kills the score —
# prevents a great pIC50 from hiding terrible covalent geometry.
_d = DF[DF["boltz_iptm"].notna()].copy() if "boltz_iptm" in DF.columns else None
if _d is not None and len(_d) > 0:
    def _pctl(s: pd.Series, higher_is_better: bool = True) -> pd.Series:
        """Percentile rank in [0, 1]; mols with NaN get 0.0 (penalised)."""
        s = pd.to_numeric(s, errors="coerce")
        if not higher_is_better:
            s = -s
        return s.rank(pct=True, method="average").fillna(0.0)

    # 1. P_potency = percentile of anchor_wins_ge7 (range 0..57; just-fixed today)
    P_pot = _pctl(_d["anchor_wins_ge7"], higher_is_better=True) \
        if "anchor_wins_ge7" in _d.columns else pd.Series(0.5, index=_d.index)
    # 2. P_pose = percentile of (lower-is-better) mPAE_london, AND-gated by ligand_iptm ≥ 0.92
    P_pose_raw = _pctl(_d["mPAE_london"], higher_is_better=False) \
        if "mPAE_london" in _d.columns else pd.Series(0.5, index=_d.index)
    iptm_gate = (pd.to_numeric(_d.get("boltz_ligand_iptm"), errors="coerce") >= 0.92).fillna(False) \
        if "boltz_ligand_iptm" in _d.columns else pd.Series(True, index=_d.index)
    P_pose = P_pose_raw.where(iptm_gate, P_pose_raw * 0.5)  # soft penalty (not zero-out) when iptm <0.92
    # 3. P_shape_to_mol1 = percentile of shape_Tc_mol1
    P_shape = _pctl(_d["shape_Tc_mol1"], higher_is_better=True) \
        if "shape_Tc_mol1" in _d.columns else pd.Series(0.5, index=_d.index)
    # 4. P_covgeom = min(percentile(d_SG inverse), percentile(BD-dev inverse))
    P_dsg  = _pctl(_d["d_SG"], higher_is_better=False) \
        if "d_SG" in _d.columns else pd.Series(0.5, index=_d.index)
    P_bd   = _pctl(_d["burgi_dunitz_dev_deg"], higher_is_better=False) \
        if "burgi_dunitz_dev_deg" in _d.columns else pd.Series(0.5, index=_d.index)
    P_geom = pd.concat([P_dsg, P_bd], axis=1).min(axis=1)
    # 5. P_clean_reactivity = percentile of -pred_log_k2_GSH (lower k2 = cleaner)
    P_react = _pctl(_d["pred_log_k2_GSH"], higher_is_better=False) \
        if "pred_log_k2_GSH" in _d.columns else pd.Series(0.5, index=_d.index)
    # 6. P_Tec_family = percentile of P_Tec_family (kinase classifier, Tec-family head)
    P_tec = _pctl(_d["P_Tec_family"], higher_is_better=True) \
        if "P_Tec_family" in _d.columns else pd.Series(0.5, index=_d.index)
    # 7. P_kinase = percentile of P_kinase (kinase classifier binary head)
    P_kin = _pctl(_d["P_kinase"], higher_is_better=True) \
        if "P_kinase" in _d.columns else pd.Series(0.5, index=_d.index)
    # 8. P_pIC50_kinase_aux = percentile of pIC50_kinase_aux (independent 2nd potency opinion)
    P_pic_aux = _pctl(_d["pIC50_kinase_aux"], higher_is_better=True) \
        if "pIC50_kinase_aux" in _d.columns else pd.Series(0.5, index=_d.index)

    # Small epsilon so a single 0 doesn't fully zero the product (allows ranking)
    EPS = 1e-3
    # 2026-06-10 PM v3: 8-component geometric mean (Σ=1.00).
    # User added P_kinase back (0.05) after analyst flagged IQR=0.526 wasn't fully
    # saturating; budget came from P_potency (-0.03) + P_pIC50_kinase_aux (-0.02).
    desirability = (
        (P_pot     + EPS) ** 0.22
        * (P_pose    + EPS) ** 0.18
        * (P_shape   + EPS) ** 0.20
        * (P_geom    + EPS) ** 0.10
        * (P_react   + EPS) ** 0.10
        * (P_tec     + EPS) ** 0.10
        * (P_kin     + EPS) ** 0.05
        * (P_pic_aux + EPS) ** 0.05
    )
    # Attach to full DF (NaN for non-Boltz rows)
    DF["desirability_score"] = pd.NA
    DF.loc[_d.index, "desirability_score"] = desirability.values
    DF.loc[_d.index, "P_potency"]          = P_pot.values
    DF.loc[_d.index, "P_pose"]             = P_pose.values
    DF.loc[_d.index, "P_shape_to_mol1"]    = P_shape.values
    DF.loc[_d.index, "P_covgeom"]          = P_geom.values
    DF.loc[_d.index, "P_clean_reactivity"] = P_react.values
    _ds_pop = DF["desirability_score"].notna().sum()
    print(f"[desirability] computed for {_ds_pop:,} Boltz-having mols  "
          f"(min={desirability.min():.3f}, med={desirability.median():.3f}, "
          f"max={desirability.max():.3f})")


