_FILTER0_VALID = ("murcko", "thiq", "murcko_and_acryl")
# 2026-06-08: Default state is "all 3 ON" — the user wants the report to start
# from the lead-optimization-relevant union. Clients (frontend or curl) get the
# OR-of-all-3 unless they explicitly opt out with ``groups=all`` / ``=none``.
_FILTER0_DEFAULT = set(_FILTER0_VALID)


def _parse_groups(req) -> set[str]:
    """Parse Filter-0 group selection from a Flask request.

    Accepts either ``?groups=murcko,thiq`` (multi) or legacy ``?group=murcko``
    (single). When the param is absent, the default is the OR-of-all-3 — see
    ``_FILTER0_DEFAULT``. To explicitly DISABLE the filter, pass
    ``groups=all`` or ``groups=none`` (empty string). Valid tokens:
    'murcko', 'thiq', 'murcko_and_acryl'.
    """
    raw_args = req.args.get("groups")
    if raw_args is None:
        raw_args = req.args.get("group")
    if raw_args is None:
        # No param at all → apply default OR-of-all-3.
        return set(_FILTER0_DEFAULT)
    raw = (raw_args or "").strip().lower()
    if raw in ("all", "none", "off"):
        # Explicit opt-out.
        return set()
    out = {tok.strip() for tok in raw.split(",") if tok.strip() in _FILTER0_VALID}
    return out


def _df_group_mask(df, groups: set[str]):
    """OR-mask over Filter-0 groups for a DataFrame with the 3 substruct cols.

    Missing columns are treated as False (cohort CSV without backfill → no rows
    match), which is the safe default. ``groups`` empty → all-True mask.
    """
    if not groups:
        return pd.Series([True] * len(df), index=df.index)
    def col(name):
        if name in df.columns:
            return df[name].fillna(False).astype(bool)
        return pd.Series([False] * len(df), index=df.index)
    mask = pd.Series([False] * len(df), index=df.index)
    if "murcko" in groups:
        mask = mask | col("mol1_murcko_smarts_match")
    if "thiq" in groups:
        mask = mask | col("thiq_core")
    if "murcko_and_acryl" in groups:
        mask = mask | (col("mol1_murcko_smarts_match") & col("acryl_match"))
    return mask


# Cache for default-OR-set mask on the main DF (set after DF assembly is done,
# at the end of the load section). Keyed only by id(DF) so a DF rebuild
# invalidates automatically.
_DEFAULT_MASK_CACHE: dict = {}


def _df_group_mask_cached(df, groups: set[str]):
    """Same as _df_group_mask but caches the default OR-set mask on DF."""
    if frozenset(groups) == frozenset(_FILTER0_DEFAULT):
        key = id(df)
        m = _DEFAULT_MASK_CACHE.get(key)
        if m is not None and len(m) == len(df):
            return m
        m = _df_group_mask(df, groups)
        _DEFAULT_MASK_CACHE.clear()
        _DEFAULT_MASK_CACHE[key] = m
        return m
    return _df_group_mask(df, groups)


