    legacy_geom_cols = ["burgi_dunitz_dev_deg", "n_h_bonds", "n_stabilizing_contacts",
                        "pocket_occupancy_pct", "atp_pocket_fraction", "hinge_hbond",
                        "warhead_atom_name", "geom_ok", "d_SG"]
