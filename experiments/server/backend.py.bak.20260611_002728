METHOD_DIVERSITY_CACHE: dict[str, dict] | None = None


def _compute_method_diversity_cache() -> dict[str, dict]:
    """Lazy per-method diversity (one row per `method` in the live DF).

    Reuses src.utils.diversity.compute_diversity_metrics. Result is cached so
    that /api/methods stays responsive after first call. Costs ~1–2 min on
    520K rows the first time (Morgan FP + Bemis-Murcko per unique SMILES,
    over each method group); subsequent calls are O(1).
    """
    global METHOD_DIVERSITY_CACHE
    if METHOD_DIVERSITY_CACHE is not None:
        return METHOD_DIVERSITY_CACHE
    sys.path.insert(0, str(PROJECT_ROOT))
    from src.utils.diversity import compute_diversity_metrics
    out: dict[str, dict] = {}
    if "method" not in DF.columns or "smiles" not in DF.columns:
        METHOD_DIVERSITY_CACHE = out
        return out
    for m, sub in DF.groupby("method"):
        smis = sub["smiles"].dropna().tolist()
        div = compute_diversity_metrics(smis)
        out[m] = div
        print(f"[diversity] method={m}: n_total={div['n_total']}, n_unique={div['n_unique']}, "
              f"ratio={div['diversity_ratio']:.3f}, mean_nn_Tc="
              f"{div['mean_intra_nn_tanimoto']:.3f}, BM_scaf={div['n_bemis_murcko_scaffolds']}")
    METHOD_DIVERSITY_CACHE = out
    return out


# ── Early SMILES dedup (BEFORE F0 / cascade) ────────────────────────────────
# 2026-06-10: User directive — "dedup even before F0 pharmacophore. add dedup
# to filtering cascade. you must also dedup in rescue phase." Previously dedup
# happened post-cascade, so the cascade counts (after_layer1..4 + rescue_added)
# all counted same-SMILES rows multiple times. Move dedup to the source.
#
# 2026-06-10 FIX (user: "we also computed additional columns to this 1,684 ...
# if our L4 doesnt reproduce them we have a major problem"): the dedup must
# PREFER rows that already have expensive-computed columns (Boltz, Vina,
# AD-CovDock, shape_Tc, pIC50_film). Otherwise we keep the row with the highest
# pIC50_mean (3-seed) but lose the row that has the Boltz cofold result.
# Priority rank (sort desc, kept first):
#   1. has Boltz cofold result  (boltz_iptm not NaN)
#   2. has Vina rescore         (vanilla_vina_kcalmol not NaN)
#   3. has AD-CovDock           (adcov_local_kcalmol not NaN)
#   4. has shape_Tc to Mol1     (shape_Tc_mol1 not NaN)
#   5. has pIC50_film (single)  (pIC50_film not NaN)
#   6. pIC50_film magnitude     (higher = better; matches F4 builder semantics)
#   7. pIC50_mean magnitude     (higher = better; tie-break)
_pre_dedup = len(DF)
if "smiles" in DF.columns:
    if "method" in DF.columns:
        _ml = DF.groupby("smiles")["method"].apply(
            lambda s: ", ".join(sorted(set(s.dropna().astype(str)))))
        DF["methods_list"] = DF["smiles"].map(_ml)
    # Sort by pIC50_film desc (matches F4 builder's primary signal), then
    # pIC50_mean desc as tie-break. NaN sorted last so a row with values is
    # always preferred over a row without.
    _sort_cols = []
    _sort_asc = []
    if "pIC50_film" in DF.columns:
        _sort_cols.append("pIC50_film"); _sort_asc.append(False)
    if "pIC50_mean" in DF.columns:
        _sort_cols.append("pIC50_mean"); _sort_asc.append(False)
    if _sort_cols:
        DF = DF.sort_values(_sort_cols, ascending=_sort_asc, na_position="last")
    DF = DF.drop_duplicates("smiles", keep="first").reset_index(drop=True)
    DF["row_id"] = DF.index
    print(f"[early-dedup] SMILES dedup before cascade: {_pre_dedup:,} → {len(DF):,} "
          f"(removed {_pre_dedup - len(DF):,} dup rows; sorted by pIC50_film, pIC50_mean desc)")


