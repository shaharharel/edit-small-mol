def _compute_tier4_mol1_stats_one(tag: str, label: str, path) -> dict | None:
    """Compute stats for a SINGLE cohort. Records source mtime so the per-cohort
    cache can invalidate when the V100 enrichment agent rewrites the CSV.

    Reads pIC50_film (preferred) then pIC50_mean (fallback for cohorts whose
    enrichment landed pIC50 under a different column name).
    """
    if path is None or not path.exists():
        return None
    try:
        df = pd.read_csv(path, low_memory=False)
    except Exception as e:
        print(f"[tier4-stats] skip {tag}: {e}")
        return None
    # Prefer pIC50_film; fall back to pIC50_mean so a cohort that gets enriched
    # AFTER backend start still reports max/median once the column lands.
    pic_series = df.get("pIC50_film")
    if pic_series is None or pd.to_numeric(pic_series, errors="coerce").notna().sum() == 0:
        pic_series = df.get("pIC50_mean")
    pic = pd.to_numeric(pic_series, errors="coerce").dropna() if pic_series is not None \
          else pd.Series(dtype=float)
    def col_bool(name):
        if name in df.columns:
            return df[name].fillna(False).astype(bool)
        return pd.Series([False] * len(df), index=df.index)
    m = col_bool("mol1_murcko_smarts_match")
    t = col_bool("thiq_core")
    a = col_bool("acryl_match")
    or_set = m | t | (m & a)
    return {
        "label": label,
        "n": int(len(df)),
        "n_potent_7": int((pic >= 7).sum()),
        "n_potent_8": int((pic >= 8).sum()),
        "n_warhead": int(col_bool("warhead_intact").sum()),
        "max_pIC50": float(pic.max()) if len(pic) else None,
        "median_pIC50": float(pic.median()) if len(pic) else None,
        "n_murcko": int(m.sum()),
        "n_thiq": int(t.sum()),
        "n_murcko_and_acryl": int((m & a).sum()),
        "n_any_of": int(or_set.sum()),
        # mtime used to invalidate the per-cohort cache when the CSV is rewritten.
        "_src_mtime": float(path.stat().st_mtime),
    }


def _compute_tier4_mol1_stats(scored_paths: dict) -> dict:
    """Pre-compute per-cohort stats for Mol1-anchored Tier 4 scored CSVs.

    Returns ``{tag: {label, n, n_potent_7, n_potent_8, n_warhead,
                     max_pIC50, median_pIC50, n_murcko, n_thiq,
                     n_murcko_and_acryl, n_any_of, _src_mtime}}``.
    ``n_any_of`` is the exact OR-set size for the 3 groups (for /api/methods).
    Missing CSVs are skipped; rows with no smiles are ignored.
    """
    stats = {}
    for tag, label in _MOL1_ANCHORED_TAGS_LABELS:
        s = _compute_tier4_mol1_stats_one(tag, label, scored_paths.get(tag))
        if s is not None:
            stats[tag] = s
    return stats


def _refresh_stale_tier4_stats() -> int:
    """Re-read any cohort whose CSV mtime is newer than the cached _src_mtime.

    Called on every /api/methods request (cheap — only stats up to a dict
    lookup + stat() syscall per cohort). Prevents the post-startup race where
    the V100 enrichment agent adds columns (pIC50_film, etc.) to a cohort CSV
    AFTER backend boot, leaving the in-memory stats stale.
    Returns the number of cohorts whose stats were refreshed.
    """
    n_refreshed = 0
    labels = dict(_MOL1_ANCHORED_TAGS_LABELS)
    for tag, path in TIER4_SCORED_PATHS.items():
        if tag not in labels:
            continue
        if path is None or not path.exists():
            continue
        try:
            cur_mtime = path.stat().st_mtime
        except OSError:
            continue
        cached = TIER4_MOL1_STATS.get(tag)
        # Tolerate sub-second filesystem clock skew (mtime granularity on
        # some filesystems is 1 s; treat anything within 0.5 s as "same").
        if cached is not None and abs(cached.get("_src_mtime", 0) - cur_mtime) < 0.5:
            continue
        new = _compute_tier4_mol1_stats_one(tag, labels[tag], path)
        if new is not None:
            old_n = cached.get("n") if cached else None
            old_p7 = cached.get("n_potent_7") if cached else None
            TIER4_MOL1_STATS[tag] = new
            n_refreshed += 1
            print(f"[tier4-stats] refreshed {tag}: n={old_n}→{new['n']} "
                  f"n_potent_7={old_p7}→{new['n_potent_7']} "
                  f"max_pIC50={new['max_pIC50']}", flush=True)
    return n_refreshed


