def _build_one_prefilter(cohort: str, src_path) -> dict:
    """Build the pre-filtered CSV for one cohort. Returns a status dict.

    Filter: rows where (mol1_murcko_smarts_match) OR (thiq_core AND
    warhead_intact) OR (mol1_murcko_smarts_match AND acryl_match).
    Note we honor the historical _df_group_mask semantics for "thiq" (uses
    thiq_core alone, NOT thiq_core & warhead_intact) so the pre-filtered CSV
    matches the default OR-set exactly. See _df_group_mask above.
    """
    try:
        df = pd.read_csv(src_path, low_memory=False)
    except Exception as e:
        return {"cohort": cohort, "ok": False, "err": str(e)}
    n_total = len(df)
    mask = _df_group_mask(df, _DEFAULT_GROUP_SET)
    sub = df[mask].reset_index(drop=True)
    dst = src_path.parent / f"{src_path.stem}_filtered.csv"
    sub.to_csv(dst, index=False)
    return {"cohort": cohort, "ok": True, "n_total": n_total, "n_kept": len(sub),
            "src_mtime": src_path.stat().st_mtime, "dst": str(dst)}


def _build_prefilters(force: bool = False) -> dict:
    """Build pre-filtered CSVs for all cohorts; skip ones whose mtime hasn't
    changed since the sentinel was written. Records new mtimes in the sentinel.
    """
    prior = {}
    if TIER4_FILTERED_SENTINEL.exists() and not force:
        try:
            prior = json.loads(TIER4_FILTERED_SENTINEL.read_text())
        except Exception:
            prior = {}
    statuses = []
    for cohort, src in TIER4_SCORED_PATHS.items():
        if src is None or not src.exists():
            continue
        dst = src.parent / f"{src.stem}_filtered.csv"
        src_mtime = src.stat().st_mtime
        recorded = prior.get(cohort, {}).get("src_mtime", 0)
        # Rebuild if: forced, dst missing, or source has been touched since.
        needs_rebuild = force or (not dst.exists()) or (src_mtime > recorded + 0.5)
        if not needs_rebuild:
            TIER4_FILTERED_PATHS[cohort] = dst
            statuses.append({"cohort": cohort, "ok": True, "skipped": True,
                             "n_kept": prior.get(cohort, {}).get("n_kept", -1)})
            continue
        st = _build_one_prefilter(cohort, src)
        statuses.append(st)
        if st.get("ok"):
            TIER4_FILTERED_PATHS[cohort] = src.parent / f"{src.stem}_filtered.csv"
            prior[cohort] = {"src_mtime": st["src_mtime"], "n_kept": st["n_kept"],
                             "n_total": st["n_total"]}
    # Persist updated sentinel.
    try:
        TIER4_FILTERED_SENTINEL.write_text(json.dumps(prior, indent=2))
    except Exception as e:
        print(f"[prefilter] sentinel write failed: {e}")
    n_built = sum(1 for s in statuses if s.get("ok") and not s.get("skipped"))
    n_skipped = sum(1 for s in statuses if s.get("skipped"))
    print(f"[prefilter] built {n_built}, skipped {n_skipped}, total cohorts mapped "
          f"{len(TIER4_FILTERED_PATHS)}")
    return {"statuses": statuses, "n_built": n_built, "n_skipped": n_skipped}


# Build at startup (synchronous — keeps the contract simple; ~1-2s for 16 cohorts
# when up-to-date, ~20-60s on first-ever launch).
_build_prefilters(force=False)


def _ensure_fresh_prefilter(cohort: str):
    """If the source CSV is newer than the pre-filtered CSV, rebuild the
    pre-filtered file in-place. Idempotent and cheap (two stat() calls when
    fresh, single read+write when stale).

    Bug-1 fix (QA 2026-06-08): the cache used to key on the FILTERED file's
    mtime only, so any agent rewriting the SOURCE CSV (V100 race-fix #19, xTB
    backfill, etc.) silently served stale data. Concrete example caught by
    QA: murcko_rl_kinase grew from 31,874 → 32,577 rows (703 new mols)
    while the report kept rendering the smaller cached subset.
    """
    src = TIER4_SCORED_PATHS.get(cohort)
    if src is None or not src.exists():
        return None
    dst = src.parent / f"{src.stem}_filtered.csv"
    src_mtime = src.stat().st_mtime
    # Fresh: dst exists AND its mtime is >= source's (allow 0.5s float fuzz).
    if dst.exists() and dst.stat().st_mtime >= src_mtime - 0.5:
        TIER4_FILTERED_PATHS[cohort] = dst
        return dst
    # Stale or missing — rebuild.
    print(f"[prefilter] STALE {cohort}: src_mtime={src_mtime} > dst_mtime="
          f"{dst.stat().st_mtime if dst.exists() else 'missing'}; rebuilding")
    st = _build_one_prefilter(cohort, src)
    if st.get("ok"):
        TIER4_FILTERED_PATHS[cohort] = dst
        # Invalidate any cached DataFrame + sort indices for this cohort.
        for k in list(_FILTERED_DF_CACHE):
            if k[0] == cohort:
                _FILTERED_DF_CACHE.pop(k, None)
        for k in list(_SORT_INDEX_CACHE):
            if k[0] == cohort:
                _SORT_INDEX_CACHE.pop(k, None)
        # Update sentinel JSON so a restart doesn't redundantly rebuild.
        try:
            prior = {}
            if TIER4_FILTERED_SENTINEL.exists():
                prior = json.loads(TIER4_FILTERED_SENTINEL.read_text())
            prior[cohort] = {"src_mtime": st["src_mtime"], "n_kept": st["n_kept"],
                             "n_total": st["n_total"]}
            TIER4_FILTERED_SENTINEL.write_text(json.dumps(prior, indent=2))
        except Exception as e:
            print(f"[prefilter] sentinel update failed: {e}")
        return dst
    return None


def _load_filtered_df(cohort: str):
    """Load (and cache) the pre-filtered DataFrame for a cohort. Returns None
    if not available. Cache is keyed on file mtime so any rebuild
    automatically invalidates. Bug-1 fix: ``_ensure_fresh_prefilter`` is
    called first to rebuild the on-disk filtered file if the source CSV
    has been touched (V100/xTB/backfill agents rewrite cohort CSVs).
    """
    dst = _ensure_fresh_prefilter(cohort)
    if dst is None or not dst.exists():
        return None
    mtime = dst.stat().st_mtime
    key = (cohort, mtime)
    cached = _FILTERED_DF_CACHE.get(key)
    if cached is not None:
        return cached
    try:
        df = pd.read_csv(dst, low_memory=False)
    except Exception as e:
        print(f"[prefilter] read failed for {cohort}: {e}")
        return None
    # Evict older entries for the same cohort.
    for k in list(_FILTERED_DF_CACHE):
        if k[0] == cohort and k != key:
            _FILTERED_DF_CACHE.pop(k, None)
    _FILTERED_DF_CACHE[key] = df
    return df


def _get_sort_index(cohort: str, view: str, column: str):
    """Return a numpy int64 array of row indices that would sort the given view
    (``"filtered"`` or ``"full"``) descending by ``column``. NaNs sink to the
    end. Cached per (cohort, view, column, mtime).
    """
    if view == "filtered":
        path = TIER4_FILTERED_PATHS.get(cohort)
    else:
        path = TIER4_SCORED_PATHS.get(cohort)
    if path is None or not path.exists():
        return None
    mtime = path.stat().st_mtime
    key = (cohort, view, column, mtime)
    cached = _SORT_INDEX_CACHE.get(key)
    if cached is not None:
        return cached
    df = _load_filtered_df(cohort) if view == "filtered" else None
    if df is None and view == "full":
        try:
            df = pd.read_csv(path, low_memory=False)
        except Exception:
            return None
    if df is None or column not in df.columns:
        return None
    col = pd.to_numeric(df[column], errors="coerce")
    # Descending sort, NaN last.
    order = (-col.fillna(-np.inf)).argsort(kind="mergesort").to_numpy()
    # Evict older keys for this (cohort,view,column).
    for k in list(_SORT_INDEX_CACHE):
        if k[:3] == key[:3] and k != key:
            _SORT_INDEX_CACHE.pop(k, None)
    _SORT_INDEX_CACHE[key] = order
    return order


@app.route("/api/cohort_smis")
def api_cohort_smis():
    """Return a Tier-4 cohort's mols as table rows compatible with leaderRenderRow.
    Prefers pre-scored CSV at data/tier4_scored/{cohort}_scored.csv if present.

    Optional query param ``groups`` (comma-separated) is an OR-set across:
        - ``murcko``           : mol1_murcko_smarts_match == True
        - ``thiq``             : thiq_core == True
        - ``murcko_and_acryl`` : mol1_murcko_smarts_match AND acryl_match True
    A row passes if it matches ANY selected group. Empty / "all" / "none" =
    no filter. Legacy single ``group=`` is accepted as a 1-element list.
    Falsy / missing columns are treated as False so a cohort without the
    substructure columns simply returns 0 rows when a filter is on (safe
    default — cohort CSVs without backfill must be re-scored to participate).
    """
    import time as _time
    _t_start = _time.perf_counter()
    cohort = request.args.get("cohort", "")
    groups = _parse_groups(request)
    bench = str(request.args.get("bench", "0")).lower() in ("1", "true", "yes")
    sort_by = request.args.get("sort_by", "").strip() or None
    try:
        limit = int(request.args.get("limit", "0") or 0)
    except Exception:
        limit = 0
    scored = TIER4_SCORED_PATHS.get(cohort)
    timing = {"path": "none"}
    if scored is not None and scored.exists():
        try:
            sdf = None
            source_tag = "scored_csv"
            # ── FAST PATH ───────────────────────────────────────────────
            # When groups is the default OR-set, the pre-filtered CSV has
            # exactly the rows we need; skip the in-memory mask too.
            if _is_default_groups(groups):
                _t_load = _time.perf_counter()
                sdf = _load_filtered_df(cohort)
                timing["filtered_load_ms"] = round((_time.perf_counter() - _t_load) * 1000, 1)
                if sdf is not None:
                    source_tag = "scored_csv_filtered"
                    timing["path"] = "prefiltered"
            # ── SLOW PATH ───────────────────────────────────────────────
            if sdf is None:
                _t_load = _time.perf_counter()
                sdf = pd.read_csv(scored, low_memory=False)
                timing["full_load_ms"] = round((_time.perf_counter() - _t_load) * 1000, 1)
                if groups:
                    _t_mask = _time.perf_counter()
                    sdf = sdf[_df_group_mask(sdf, groups)].reset_index(drop=True)
                    timing["mask_ms"] = round((_time.perf_counter() - _t_mask) * 1000, 1)
                timing["path"] = "full"
            # ── Optional column-sort fast path ──────────────────────────
            _t_sort = _time.perf_counter()
            if sort_by and sort_by in sdf.columns:
                view = "filtered" if source_tag == "scored_csv_filtered" else "full"
                idx = _get_sort_index(cohort, view, sort_by)
                if idx is not None and len(idx) == len(sdf):
                    sdf = sdf.iloc[idx].reset_index(drop=True)
                else:
                    col = pd.to_numeric(sdf[sort_by], errors="coerce")
                    sdf = sdf.iloc[(-col.fillna(-np.inf)).argsort(kind="mergesort").to_numpy()].reset_index(drop=True)
            timing["sort_ms"] = round((_time.perf_counter() - _t_sort) * 1000, 1)
            # Default sort by pIC50 only when sort_by wasn't specified — done
            # at the DataFrame level (vectorized) instead of post-serialize.
            if not sort_by:
                _t_dsort = _time.perf_counter()
                pic = None
                if "pIC50_film" in sdf.columns:
                    pic = pd.to_numeric(sdf["pIC50_film"], errors="coerce")
                if pic is None or pic.isna().all():
                    if "pIC50_mean" in sdf.columns:
                        pic2 = pd.to_numeric(sdf["pIC50_mean"], errors="coerce")
                        pic = pic2 if pic is None else pic.fillna(pic2)
                if pic is not None:
                    order = (-pic.fillna(-np.inf)).argsort(kind="mergesort").to_numpy()
                    sdf = sdf.iloc[order].reset_index(drop=True)
                timing["default_sort_ms"] = round((_time.perf_counter() - _t_dsort) * 1000, 1)
            if limit > 0:
                sdf = sdf.head(limit)
            # ── Vectorized JSON-safe serialization (Bug-2 fix, 2026-06-08) ──
            # Was: per-row .iterrows() + pd.isna(v) on every cell → 12-15s for
            # 77K rows. Now: replace NaN→None at column level, cast numpy
            # scalars in bulk via astype(object), then to_dict(orient="records").
            _t_rows = _time.perf_counter()
            sdf_out = sdf
            # row_id / method backfill — vectorized.
            n = len(sdf_out)
            if "row_id" not in sdf_out.columns:
                sdf_out = sdf_out.assign(row_id=[f"{cohort}_{i}" for i in range(n)])
            else:
                mask_rid = sdf_out["row_id"].isna() | (sdf_out["row_id"].astype(str) == "")
                if mask_rid.any():
                    fillvals = [f"{cohort}_{i}" for i in np.where(mask_rid.to_numpy())[0]]
                    sdf_out = sdf_out.copy()
                    sdf_out.loc[mask_rid, "row_id"] = fillvals
            method_label = f"Tier 4 — {cohort.upper()}"
            if "method" not in sdf_out.columns:
                sdf_out = sdf_out.assign(method=method_label)
            else:
                mask_m = sdf_out["method"].isna() | (sdf_out["method"].astype(str) == "")
                if mask_m.any():
                    sdf_out = sdf_out.copy()
                    sdf_out.loc[mask_m, "method"] = method_label
            # Replace NaN with None for JSON compatibility, then dump.
            rows = sdf_out.astype(object).where(sdf_out.notna(), None).to_dict(orient="records")
            timing["serialize_ms"] = round((_time.perf_counter() - _t_rows) * 1000, 1)
            timing["total_ms"] = round((_time.perf_counter() - _t_start) * 1000, 1)
            resp = jsonify({"rows": rows, "n_rows": len(rows), "cohort": cohort,
                            "groups": sorted(groups) if groups else None, "source": source_tag,
                            "_timing": timing if bench else None})
            resp.headers["X-Backend-Path"] = timing["path"]
            resp.headers["X-Backend-Total-Ms"] = str(timing["total_ms"])
            return resp
        except Exception as e:
            # Fall through to SMI loader on read error rather than 500.
            print(f"[tier4] scored CSV read failed for {cohort}: {e}", flush=True)
    path = COHORT_SMI_PATHS.get(cohort)
    if path is None or not path.exists():
        return jsonify({"rows": [], "error": f"unknown cohort {cohort}"}), 404
    rows = []
    try:
        with open(path) as f:
            header = next(f, "").strip().lower().split("\t")
        df = pd.read_csv(path, sep="\t")
        # Try to enrich with FiLMDelta pIC50 + RDKit-derived columns
        from rdkit import Chem as _Chem
        from rdkit.Chem import Descriptors as _Desc, QED as _QED
        for i, row in df.iterrows():
            smi = row.get("smiles") or row.get("SMILES") or ""
            if not isinstance(smi, str) or not smi:
                continue
            mol = _Chem.MolFromSmiles(smi)
            if mol is None:
                continue
            r = {"row_id": f"{cohort}_{i}", "smiles": smi,
                 "method": f"Tier 4 — {cohort.upper()}",
                 "pIC50_film": float(row.get("predicted_pIC50", "nan")) if row.get("predicted_pIC50", None) is not None else None,
                 "MW": float(_Desc.MolWt(mol)),
                 "QED": float(_QED.qed(mol)),
                 "HeavyAtoms": int(mol.GetNumHeavyAtoms()),
                 "warhead_intact": True,
                 "warhead": int(row.get("warhead", 1)) if "warhead" in df.columns else 1,
                 "Tc_to_anchor": float(row.get("tc_to_anchor", "nan")) if "tc_to_anchor" in df.columns else None,
                 "nll": float(row.get("nll", "nan")) if "nll" in df.columns else None,
                 }
            # if predicted_pIC50 column exists explicitly
            if "predicted_pIC50" in df.columns:
                try: r["pIC50_film"] = float(row["predicted_pIC50"])
                except Exception: pass
            elif "pIC50_film" in df.columns:
                try: r["pIC50_film"] = float(row["pIC50_film"])
                except Exception: pass
            rows.append(r)
            if len(rows) >= 500:
                break
    except Exception as e:
        return jsonify({"rows": [], "error": str(e)}), 500
    rows.sort(key=lambda x: -(x.get("pIC50_film") or 0))
    return jsonify({"rows": rows, "n_rows": len(rows), "cohort": cohort})


