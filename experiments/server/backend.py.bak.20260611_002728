    _lg_keep["row_id"] = _lg_keep["row_id"].astype(int)
    # Use combine_first so we DON'T clobber any existing values from prior merges —
    # only fill where legacy 997 has data and the DF is currently NaN.
    DF = DF.merge(_lg_keep, on="row_id", how="left", suffixes=("", "_lg997"))
    for c in legacy_geom_cols:
        lg_col = f"{c}_lg997"
        if lg_col in DF.columns:
            # Backfill: if the current column is NaN but legacy has a value, use legacy
            if c in DF.columns:
                mask = DF[c].isna() & DF[lg_col].notna()
                DF.loc[mask, c] = DF.loc[mask, lg_col]
            else:
                DF[c] = DF[lg_col]
            DF = DF.drop(columns=[lg_col])
    n_bd = DF["burgi_dunitz_dev_deg"].notna().sum() if "burgi_dunitz_dev_deg" in DF.columns else 0
    print(f"Backfilled legacy 997 burgi_dunitz_dev_deg + geom; total coverage now {n_bd}")
