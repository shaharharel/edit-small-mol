@app.route("/api/spec")
def api_spec():
    """Return the filter+ranking spec JSON. Single source of truth (the docs
    page and the dashboard UI both render from this)."""
    return jsonify(FILTER_SPEC)


def _parse_filter_settings(payload: dict) -> dict:
    """Pull per-filter on/cutoff overrides out of a JSON or query payload.

    Accepts either:
      - JSON: {"filters": {"f1_mw": {"on": true, "cutoff": 700}, ...}}
      - Query: ?f1_mw_on=1&f1_mw_cutoff=700&...
      - Layer-level shortcuts: ?layer1_enabled=1&layer2_enabled=0
    """
    settings: dict = {}
    # JSON body
    if isinstance(payload.get("filters"), dict):
        settings.update(payload["filters"])

    # Layer-level shortcuts
    for layer in ("layer0_vetoes", "layer1", "layer2", "layer3", "layer4", "layer5"):
        enabled_key = f"{layer}_enabled"
        if enabled_key in payload:
            v = payload[enabled_key]
            on = str(v).lower() in ("1", "true", "yes", "on")
            for f in FILTER_SPEC[layer]["filters"]:
                settings.setdefault(f["id"], {})
                settings[f["id"]]["on"] = on

    # Per-filter query params: <id>_on=1, <id>_cutoff=700
    for layer in ("layer0_vetoes", "layer1", "layer2", "layer3", "layer4", "layer5"):
        for f in FILTER_SPEC[layer]["filters"]:
            fid = f["id"]
            if f"{fid}_on" in payload:
                v = payload[f"{fid}_on"]
                on = str(v).lower() in ("1", "true", "yes", "on")
                settings.setdefault(fid, {})["on"] = on
            if f"{fid}_cutoff" in payload:
                raw = payload[f"{fid}_cutoff"]
                try:
                    settings.setdefault(fid, {})["cutoff"] = float(raw)
                except (TypeError, ValueError):
                    if isinstance(raw, bool):
                        settings.setdefault(fid, {})["cutoff"] = raw
    return settings


# Default-filter precompute cache. Filled at startup by _precompute_default_filter()
# so the FIRST request from a fresh browser hits a warm cache (sub-millisecond).
# Invalidated only on backend restart; keyed by "default" since the request is
# the canonical "no params" case (method=_all, groups=default OR-set, all L1-L5
# defaults, composite ON).
_DEFAULT_FILTER_CACHE: dict = {}


# ── /api/filter TTL cache (UI-QA fix, 2026-06-08) ──────────────────────────
# UI-QA agent measured 34-60s per /api/filter call (entire cascade rebuilt on
# every "Apply" press, no cache). The Apply button is hit N times with the
# SAME filter combo as the user toggles unrelated UI bits → cache by
# payload-hash with short TTL gives near-instant repeat hits. Cache keys
# include id(DF) so any DF mutation (e.g. report-agent adding 423K Mol1
# cohorts) automatically invalidates without explicit purge.
import hashlib as _hashlib
import time as _time_mod
_FILTER_TTL_SECONDS = 60
_FILTER_CACHE_MAX = 64
_FILTER_CACHE: dict = {}  # key -> (timestamp, response_dict)
# Lightweight hit/miss counters (exposed via /api/health).
_FILTER_CACHE_STATS = {"hits": 0, "misses": 0, "evictions": 0,
                       "default_fast_path": 0, "invalidations": 0}


def _filter_cache_key(payload: dict) -> str:
    """Canonical hash for an /api/filter payload. Includes id(DF) so DF
    mutations automatically invalidate every entry without a purge call.
    """
    # Sort keys; stringify values so booleans / numbers normalize identically
    # across JSON-body and query-string forms.
    canon = {str(k): str(v) for k, v in payload.items()
             if v not in (None, "")}
    blob = json.dumps(canon, sort_keys=True)
    # id(DF) shifts whenever DF is reassigned (the report agent rebuilds DF
    # via DF = pd.concat([...]) → new object id).
    return _hashlib.sha1(f"{id(DF)}|{blob}".encode()).hexdigest()


def _filter_cache_get(key: str):
    now = _time_mod.time()
    entry = _FILTER_CACHE.get(key)
    if entry is None:
        return None
    ts, resp = entry
    if now - ts > _FILTER_TTL_SECONDS:
        _FILTER_CACHE.pop(key, None)
        return None
    return resp


def _filter_cache_put(key: str, resp: dict):
    now = _time_mod.time()
    _FILTER_CACHE[key] = (now, resp)
    if len(_FILTER_CACHE) > _FILTER_CACHE_MAX:
        # LRU-ish: drop oldest by timestamp.
        oldest = min(_FILTER_CACHE.items(), key=lambda kv: kv[1][0])[0]
        _FILTER_CACHE.pop(oldest, None)
        _FILTER_CACHE_STATS["evictions"] += 1


def _default_filter_payload() -> dict:
    """Canonical payload representing "open the page with no settings touched"."""
    return {}  # All filters fall back to FILTER_SPEC defaults.


def _run_filter_pipeline(payload: dict) -> dict:
    """Pure-function version of api_filter's body. Returns the same dict that
    api_filter would jsonify(). Used both by /api/filter and by the startup
    precompute so the cache is byte-identical to a live response.
    """
    df = DF
    method_filter = payload.get("method", "")
    if method_filter and method_filter != "_all" and "method" in df.columns:
        df = df[df["method"] == method_filter]

    n_unfiltered = int(len(df))

    if "groups" in payload or "group" in payload:
        raw = (payload.get("groups") or payload.get("group") or "").strip().lower()
        if raw in ("all", "none", "off"):
            groups = set()
        else:
            groups = {t.strip() for t in raw.split(",") if t.strip() in _FILTER0_VALID}
    else:
        groups = set(_FILTER0_DEFAULT)
    if groups:
        df = df[_df_group_mask_cached(df, groups)]

    settings = _parse_filter_settings(payload)
    mask, failed, counts = apply_filter_cascade(df, settings)
    visible = df[mask].copy()
    visible["_failed_filters"] = failed.loc[visible.index].apply(lambda x: list(x))
    visible["_pass_count"] = 0
    if "high_score_count" not in visible.columns:
        visible["high_score_count"] = compute_high_score_count(visible)
    visible["score"] = compute_composite_score(visible)
    visible["_score"] = visible["score"]
    # 2026-06-10: post-cascade SMILES dedup is no longer needed — DF was
    # deduplicated at module import time (see "Early SMILES dedup" section
    # above). `methods_list` is already attached on DF. Cascade counts are
    # now unique-mol counts directly.

    composite = str(payload.get("composite", "1")).lower() in ("1", "true", "yes", "on")
    sort_str = payload.get("sort", "")
    if composite and not sort_str:
        # 2026-06-10 PM v3: default-sort by Combined Score (desirability_score)
        # — the 8-component geometric-mean ranker. Fall back to legacy `score`
        # column for non-Boltz mols that have NaN desirability.
        sort_pairs = [("desirability_score", "desc"), ("score", "desc")]
    elif sort_str:
        sort_pairs = []
        for token in sort_str.split(","):
            if ":" in token:
                col, d = token.split(":", 1)
                sort_pairs.append((col.strip(), d.strip().lower()))
            else:
                sort_pairs.append((token.strip(), "desc"))
    else:
        sort_pairs = [(s["col"], s["dir"]) for s in FILTER_SPEC["simple_sort"]]
    sort_cols = [c for c, _ in sort_pairs if c in visible.columns]
    sort_dirs = [d == "asc" for c, d in sort_pairs if c in visible.columns]
    if sort_cols:
        visible = visible.sort_values(sort_cols, ascending=sort_dirs, na_position="last")

    start = int(payload.get("start", 0))
    length = int(payload.get("length", 200))
    n_visible = len(visible)
    if length < 0:
        length = n_visible
    page = visible.iloc[start:start + length]
    page = page.astype(object).where(page.notna(), None)
    rows = page.to_dict(orient="records")

    counts["total_unfiltered"] = n_unfiltered
    counts["after_filter0"] = counts.get("total", n_unfiltered)
    return {
        "counts": counts,
        "n_visible": n_visible,
        "start": start,
        "length": length,
        "rows": rows,
        "sort": [{"col": c, "dir": d} for c, d in sort_pairs],
        "composite": composite,
    }


def _is_default_filter_request(payload: dict) -> bool:
    """True iff this payload matches the canonical default (method=_all OR
    missing, no groups param, no L1-L5 settings, no sort, composite=1 or
    missing, start=0 or missing, length absent or default 200).

    Bug fix 2026-06-10: previous logic stripped any key whose value was the
    literal string "0", which silently misclassified `f1_qed_on=0`,
    `f1_brenk_on=0`, `layer3_enabled=0` etc. as "default" and served the
    stale precompute. Per-filter `_on` / `_cutoff` / layer `_enabled` /
    `filters` / `groups` / `group` / `method` / `sort` PRESENCE (regardless
    of value) means the request is non-default and must run the cascade.
    """
    # Any presence of these keys disqualifies the default fast-path.
    NONDEFAULT_KEY_SUFFIXES = ("_on", "_cutoff", "_enabled")
    NONDEFAULT_KEYS = {"filters", "groups", "group", "method", "sort"}
    for k, v in payload.items():
        if v in (None, ""):
            continue
        if k in NONDEFAULT_KEYS:
            # method=_all is the "all methods" sentinel; treat as default.
            if k == "method" and str(v) == "_all":
                continue
            return False
        if any(k.endswith(s) for s in NONDEFAULT_KEY_SUFFIXES):
            return False
    if "start" in payload and str(payload["start"]) not in ("0", ""):
        return False
    if "length" in payload and str(payload["length"]) not in ("200", ""):
        return False
    if "composite" in payload and str(payload["composite"]).lower() not in ("1", "true", "yes", "on", ""):
        return False
    return True


@app.route("/api/filter", methods=["GET", "POST"])
def api_filter():
    """Apply F1-F5 cascade + sort + (optional) composite scoring.

    Query/JSON params:
      layer{1..5}_enabled : 0/1 — bulk toggle a layer
      <filter_id>_on      : 0/1 — toggle one filter
      <filter_id>_cutoff  : float — override cutoff
      sort                : comma-separated 'col:dir' pairs (overrides default simple sort)
      composite           : 0/1 — sort by composite score column
      method              : restrict to one method (else _all)
      start, length       : pagination (length=-1 returns everything)
    """
    t_start = _time_mod.perf_counter()
    if request.method == "POST":
        payload = request.get_json(silent=True) or request.form.to_dict() or {}
    else:
        payload = request.args.to_dict()
    bench = str(payload.pop("bench", "0") if isinstance(payload, dict) else "0").lower() in ("1", "true", "yes")

    # Fast path #1 — canonical default (no settings touched) ⇒ serve the
    # startup precompute. Saves ~3-8 s on the cold first request.
    if _DEFAULT_FILTER_CACHE and _is_default_filter_request(payload):
        _FILTER_CACHE_STATS["default_fast_path"] += 1
        resp = jsonify(_DEFAULT_FILTER_CACHE)
        resp.headers["X-Filter-Cache"] = "default-precompute"
        resp.headers["X-Filter-Total-Ms"] = str(round((_time_mod.perf_counter() - t_start) * 1000, 1))
        return resp

    # Fast path #2 — payload-hash TTL cache. Same filter combo within 60 s ⇒
    # serve the cached response. id(DF) is part of the key so any DF
    # mutation invalidates automatically.
    cache_key = _filter_cache_key(payload)
    cached = _filter_cache_get(cache_key)
    if cached is not None:
        _FILTER_CACHE_STATS["hits"] += 1
        resp = jsonify(cached)
        resp.headers["X-Filter-Cache"] = "ttl-hit"
        resp.headers["X-Filter-Total-Ms"] = str(round((_time_mod.perf_counter() - t_start) * 1000, 1))
        return resp

    # Slow path — run the full cascade, then cache.
    _FILTER_CACHE_STATS["misses"] += 1
    t_pipe = _time_mod.perf_counter()
    result = _run_filter_pipeline(payload)
    pipe_ms = round((_time_mod.perf_counter() - t_pipe) * 1000, 1)
    _filter_cache_put(cache_key, result)
    resp = jsonify(result)
    resp.headers["X-Filter-Cache"] = "miss"
    resp.headers["X-Filter-Pipeline-Ms"] = str(pipe_ms)
    resp.headers["X-Filter-Total-Ms"] = str(round((_time_mod.perf_counter() - t_start) * 1000, 1))
    if bench:
        print(f"[/api/filter MISS] pipeline={pipe_ms}ms  cache_size={len(_FILTER_CACHE)}  "
              f"hits={_FILTER_CACHE_STATS['hits']} misses={_FILTER_CACHE_STATS['misses']}", flush=True)
    return resp


@app.route("/api/health")
def api_health():
    cs = _FILTER_CACHE_STATS
    total = cs["hits"] + cs["misses"]
    hit_rate = round(cs["hits"] / total * 100, 1) if total else 0.0
    return jsonify({"ok": True, "n_rows": len(DF), "columns": list(DF.columns),
                    "methods": list(DF["method"].unique()) if "method" in DF.columns else [],
                    "filter_cache": {
                        "size": len(_FILTER_CACHE),
                        "ttl_seconds": _FILTER_TTL_SECONDS,
                        "hits": cs["hits"], "misses": cs["misses"],
                        "default_fast_path": cs["default_fast_path"],
                        "evictions": cs["evictions"],
                        "invalidations": cs["invalidations"],
                        "hit_rate_pct": hit_rate,
                        "df_id": id(DF),
                    }})


@app.route("/api/admin/invalidate_filter_cache", methods=["POST", "GET"])
def api_admin_invalidate_filter_cache():
    """Clear the /api/filter TTL cache. Used by external agents (e.g. the
    Report agent) after they mutate DF so subsequent Apply presses recompute.
    Idempotent. id(DF) keying already auto-invalidates on DF reassignment,
    so this endpoint is a belt-and-suspenders for in-place mutations.
    """
    n_before = len(_FILTER_CACHE)
    _FILTER_CACHE.clear()
    _DEFAULT_FILTER_CACHE.clear()
    _FILTER_CACHE_STATS["invalidations"] += 1
    print(f"[filter-cache] manually invalidated {n_before} entries; precompute will rerun lazily", flush=True)
    return jsonify({"ok": True, "cleared": n_before})


